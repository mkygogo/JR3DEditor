FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.2.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/core/package.json packages/core/package.json
COPY packages/scene-editor/package.json packages/scene-editor/package.json
COPY packages/asset-manager/package.json packages/asset-manager/package.json
COPY packages/portal/package.json packages/portal/package.json
RUN pnpm config set registry https://registry.npmmirror.com && pnpm install --no-frozen-lockfile
COPY . .
RUN pnpm --filter @meteor3d/core build \
    && VITE_BASE_PATH=/editor/ pnpm --filter @meteor3d/scene-editor build \
    && VITE_BASE_PATH=/asset/ pnpm --filter @meteor3d/asset-manager build \
    && VITE_BASE_PATH=/portal/ pnpm --filter @meteor3d/portal build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/packages/scene-editor/dist /usr/share/nginx/html/editor
COPY --from=builder /app/packages/asset-manager/dist /usr/share/nginx/html/asset
COPY --from=builder /app/packages/portal/dist /usr/share/nginx/html/portal
